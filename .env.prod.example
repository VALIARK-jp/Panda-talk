# テスター配布・本番相当ビルド用テンプレ（コピー → `.env.prod`、gitignore 済み）
# 手順: docs/16_valiark_prod_panda_talk_setup.md
#
# 秘密は 1Password 等から貼る。本ファイルをコミットしない。

# --- valiark-prod（Dashboard → Settings → API）---
PANDA_TALK_SUPABASE_URL=https://YOUR_VALIARK_PROD_PROJECT_REF.supabase.co
PANDA_TALK_SUPABASE_ANON_KEY=

# --- prod Worker（backend: npm run deploy:prod）---
PANDA_TALK_API_BASE_URL=https://panda-talk-backend-prod.YOUR_ACCOUNT.workers.dev

# SNS共有URL（本番テスター・TestFlight 向け。valiark.jp → prod Worker に rewrite）
PANDA_TALK_SHARE_BASE_URL=https://valiark.jp/panda-talk

# Auth（Supabase Redirect URLs / iOS・Android scheme と一致）
PANDA_TALK_AUTH_REDIRECT_URL=io.valiark.pandatalk://callback
PANDA_TALK_WEB_AUTH_REDIRECT_URL=https://valiark.jp/panda-talk/auth/callback

# prod テスター向け通知テストボタン（設定画面の確認用）
PANDA_TALK_ENABLE_NOTIFICATION_TEST=true

PANDA_TALK_TERMS_URL=https://valiark.jp/panda-talk/terms_of_service
PANDA_TALK_PRIVACY_URL=https://valiark.jp/panda-talk/privacy_policy

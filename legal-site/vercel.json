{
  "rewrites": [
    {
      "source": "/panda-talk",
      "destination": "/panda-talk/index.html"
    },
    {
      "source": "/panda-talk/privacy_policy",
      "destination": "/panda-talk/privacy_policy/index.html"
    },
    {
      "source": "/panda-talk/terms_of_service",
      "destination": "/panda-talk/terms_of_service/index.html"
    },
    {
      "source": "/panda-talk/q/:id",
      "destination": "https://panda-talk-backend-prod.valiark.workers.dev/share/q/:id"
    },
    {
      "source": "/panda-talk/u/:username",
      "destination": "https://panda-talk-backend-prod.valiark.workers.dev/share/u/:username"
    },
    {
      "source": "/panda-talk/type/:slug",
      "destination": "https://panda-talk-backend-prod.valiark.workers.dev/share/type/:slug"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}

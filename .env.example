# コピーして `.env` にリネーム。秘密の分類: docs/valiark_client_secrets_playbook.md
#
# baselink と同じ考え方:
#   - 認証 → Supabase（https://….supabase.co）… 実機からそのまま届く
#   - アプリ API → チームの dev 環境 HTTPS … 実機からそのまま届く（localhost はシミュレータ専用）

# --- チームから配布（必須） ---
PANDA_TALK_SUPABASE_URL=
PANDA_TALK_SUPABASE_ANON_KEY=

# Panda Talk BFF（Cloudflare Worker）。実機・日常開発はここを dev デプロイ URL にする。
# 例: https://panda-talk-backend.<account>.workers.dev  （backend で npm run deploy 後）
# PANDA_TALK_API_BASE_URL=https://panda-talk-backend.xxxxx.workers.dev

# Mac 上で wrangler dev だけ使う（iOS シミュレータ向け）ときだけ:
PANDA_TALK_API_BASE_URL=http://localhost:8787

# メール確認 / パスワードリセット用。Supabase Redirect URLs と iOS/Android URL scheme と一致させる。
PANDA_TALK_AUTH_REDIRECT_URL=io.valiark.pandatalk://callback

# LINE チャンネル ID は通常不要（既定 2010102462）。Edge Secret `LINE_CHANNEL_ID` と同値。
# PANDA_TALK_LINE_CHANNEL_ID=2010102462

# PANDA_TALK_TERMS_URL=
# PANDA_TALK_PRIVACY_URL=

# コピーして `.env` にリネーム（gitignore）し、空欄をチームから受け取った値で埋める。
# 詳細: docs/valiark_client_secrets_playbook.md

# 公開前提の開発用のみ（必要なら変える）
# シミュレータ: 通常は localhost で Mac 上の Worker に届く。
# 実機: localhost はスマホ自身になるため届かない。.env を Mac の LAN IP に変更する
#       例: PANDA_TALK_API_BASE_URL=http://192.168.0.12:8787
#       Worker 側は LAN から受け付けるよう WRANGLER_DEV_IP=0.0.0.0 を付けて起動
#       （backend/scripts/dev-with-supabase.mjs が wrangler --ip に渡す）
PANDA_TALK_API_BASE_URL=http://localhost:8787
VALIARK_AUTH_REDIRECT_URL=io.valiark.auth://callback

# チームから配布（リポジトリにコミットしない）
PANDA_TALK_SUPABASE_URL=
PANDA_TALK_SUPABASE_ANON_KEY=
PANDA_TALK_LINE_CHANNEL_ID=

# 利用規約・プライバシー（HTTPS。空なら「準備中」表示）
# PANDA_TALK_TERMS_URL=https://example.com/terms
# PANDA_TALK_PRIVACY_URL=https://example.com/privacy
